# Clean-SV reimplementation of the COP SIO (module t400_sio_0_0), extracted from
# t420_notri.v. Fixes a Verilator eval hazard; must compile alongside the .v.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/t400_sio.sv
set_global_assignment -name SYSTEMVERILOG_FILE Apple-Lisa.sv
